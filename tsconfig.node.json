{
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // TypeScript 7 defaults `types` to []. `"*"` keeps automatic @types inclusion.
    "types": ["*"]
  },
  "include": ["vite.config.ts"]
}
