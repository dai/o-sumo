  Cache-Control: private, no-cache, no-transform
  Vary: Accept

# Agent discovery API catalog
/.well-known/api-catalog
  Cache-Control: public, max-age=300
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Link: </.well-known/api-catalog>; rel="api-catalog"

# ARD Agentic Resource Discovery (ai-catalog.json)
/.well-known/ai-catalog.json
  Cache-Control: public, max-age=300
  Content-Type: application/json; charset=utf-8
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog"

# Agent Skills index (RFC v0.2.0)
/.well-known/agent-skills/index.json
  Cache-Control: public, max-age=300
  Content-Type: application/json
  Link: </.well-known/agent-skills/index.json>; rel="agent-skills"

# Agent Skills SKILL.md files
/.well-known/agent-skills/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300

# MCP Server Card
/.well-known/mcp/server-card.json
  Cache-Control: public, max-age=300
  Content-Type: application/json

# A2A Agent Card (RFC 8615 well-known URI)
# See: https://a2a-protocol.org/latest/topics/agent-discovery/
/.well-known/agent-card.json
  Cache-Control: public, max-age=300
  Content-Type: application/json
  Link: </.well-known/agent-card.json>; rel="agent-card"

# A2A JSON-RPC endpoint (Cloudflare Pages Function, see functions/a2a/)
# Implemented as a JSON-RPC 2.0 stub that returns -32601 Method not found
# for every A2A method — the site has no task state.
# See: https://a2a-protocol.org/latest/specification/#6-json-rpc-20-transport
/a2a
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept

# OAuth Authorization Server Metadata (RFC 8414) + agent_auth extension
/.well-known/oauth-authorization-server
  Cache-Control: public, max-age=300
  Content-Type: application/json

# OAuth Protected Resource Metadata (RFC 9728)
/.well-known/oauth-protected-resource
  Cache-Control: public, max-age=300
  Content-Type: application/json

# Web Bot Auth (IETF WebBotAuth WG) signature directory
# The response is self-signed per-request with a fresh `created`/`expires`/`nonce`,
# so we cache for a single minute — long enough to absorb abuse, short enough that
# the `expires` claim never lags behind the live signature.
# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Signature
/.well-known/http-message-signatures-directory
  Cache-Control: public, max-age=60
  Content-Type: application/http-message-signatures-directory+json
